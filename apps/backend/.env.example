# Server
APP_ENV=development
PORT=8080

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Generate a random secret, e.g.: openssl rand -base64 32
TELEGRAM_WEBHOOK_SECRET=


# Database
DATABASE_URL=postgres://postgres:password@127.0.0.1:5433/omni?sslmode=disable
ATLAS_DEV_URL=postgres://postgres:password@127.0.0.1:5433/omni-atlas?sslmode=disable

# Google OAuth
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# generate encryption key using this command: openssl rand -base64 32
# ENCRYPTION_KEY must be exactly 32 bytes for AES-256.
ENCRYPTION_KEY=your-encryption-key

