# Server
APP_ENV=development
PORT=8080

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET= // generate a random secret for your webhook. you can run `openssl rand -base64 32` to generate a random secret.


# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/omni-bot?sslmode=disable
ATLAS_DEV_URL=postgres://postgres:password@localhost:5432/omni-bot-atals?sslmode=disable
